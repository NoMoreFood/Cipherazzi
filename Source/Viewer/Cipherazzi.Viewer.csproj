<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>../Assets/Cipherazzi.ico</ApplicationIcon>
    <AssemblyName>Cipherazzi.Viewer</AssemblyName>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Assets/Cipherazzi.ico" LogicalName="Cipherazzi.Viewer.Cipherazzi.ico" />
    <None Update="Cipherazzi.Viewer.config" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <ProjectReference Include="../Data/Cipherazzi.Data.csproj" />
    <Using Include="Cipherazzi.Data" />
    <Using Include="System.Data.Common" />
    <InternalsVisibleTo Include="Cipherazzi.UiTests" />
  </ItemGroup>
</Project>
