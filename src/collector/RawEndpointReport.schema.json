{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cipherazzi public raw encryption report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "pid", "process_started_us", "operation_started_us", "timestamp_us",
    "local", "remote", "role", "transport", "success", "algorithm", "mode", "key_bits"],
  "properties": {
    "schema": { "const": "cipherazzi.raw/1" },
    "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
    "pid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "process_started_us": { "type": "integer", "minimum": 1, "maximum": 253402300799999999 },
    "operation_started_us": { "type": "integer", "minimum": 1, "maximum": 253402300799999999 },
    "timestamp_us": { "type": "integer", "minimum": 1, "maximum": 253402300799999999 },
    "local": { "$ref": "#/$defs/endpoint" },
    "remote": { "$ref": "#/$defs/endpoint" },
    "role": { "enum": ["client", "server"] },
    "transport": { "enum": ["TCP", "UDP"] },
    "success": { "type": "boolean" },
    "algorithm": { "type": "string", "minLength": 1, "maxLength": 128 },
    "mode": { "type": "string", "minLength": 1, "maxLength": 64 },
    "key_bits": { "type": "integer", "minimum": 1, "maximum": 65536 }
  },
  "$defs": {
    "endpoint": {
      "type": "object", "required": ["address", "port"], "additionalProperties": false,
      "properties": { "address": { "type": "string", "maxLength": 45 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
    }
  }
}
