#include <windows.h>

1 ICON "assets/Cipherazzi.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CIPHERAZZI_VERSION
 PRODUCTVERSION CIPHERAZZI_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Cipherazzi"
            VALUE "FileDescription", "Cipherazzi network cryptography collector"
            VALUE "FileVersion", CIPHERAZZI_VERSION_TEXT ".0"
            VALUE "InternalName", "Cipherazzi.Collector"
            VALUE "OriginalFilename", "Cipherazzi.Collector.exe"
            VALUE "ProductName", "Cipherazzi"
            VALUE "ProductVersion", CIPHERAZZI_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
