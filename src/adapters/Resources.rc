#include <windows.h>

1 ICON "assets/Cipherazzi.ico"
101 RCDATA "adapters/EndpointAgent.js"
102 RCDATA "adapters/FirefoxObserver.js"
103 RCDATA "adapters/SchannelObserver.js"
104 RCDATA "adapters/GoObserver.js"
105 RCDATA "adapters/GoProbe.c"
106 RCDATA "adapters/RustlsObserver.js"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CIPHERAZZI_VERSION
 PRODUCTVERSION CIPHERAZZI_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Cipherazzi"
            VALUE "FileDescription", "Cipherazzi public endpoint adapter"
            VALUE "FileVersion", CIPHERAZZI_VERSION_TEXT ".0"
            VALUE "InternalName", "Cipherazzi.EndpointAdapter"
            VALUE "OriginalFilename", "Cipherazzi.EndpointAdapter.exe"
            VALUE "ProductName", "Cipherazzi"
            VALUE "ProductVersion", CIPHERAZZI_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
