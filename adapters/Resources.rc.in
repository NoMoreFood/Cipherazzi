#include <windows.h>

1 ICON "@PROJECT_SOURCE_DIR@/assets/Cipherazzi.ico"
101 RCDATA "@PROJECT_SOURCE_DIR@/adapters/EndpointAgent.js"
102 RCDATA "@PROJECT_SOURCE_DIR@/adapters/FirefoxObserver.js"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Cipherazzi"
            VALUE "FileDescription", "Cipherazzi public endpoint adapter"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "Cipherazzi.EndpointAdapter"
            VALUE "OriginalFilename", "Cipherazzi.EndpointAdapter.exe"
            VALUE "ProductName", "Cipherazzi"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
